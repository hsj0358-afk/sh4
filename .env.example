# =========================================================================
# 비밀 설정값 — 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋 금지)
#   cp .env.example .env
# =========================================================================

# --- Claude API ---
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# 사용할 모델 (기본: claude-opus-4-8). 비용 절감하려면 claude-sonnet-4-6 등으로 변경
ANTHROPIC_MODEL=claude-opus-4-8

# --- Gmail 발송 (앱 비밀번호 사용) ---
# 1) 구글 계정 2단계 인증 켜기
# 2) https://myaccount.google.com/apppasswords 에서 16자리 앱 비밀번호 생성
GMAIL_USER=your_id@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# 받는 사람 (여러 명이면 쉼표로 구분)
BRIEFING_TO=boss@company.com,me@gmail.com
# (선택) 보내는 사람 표시 이름
BRIEFING_FROM_NAME=신문 브리핑 봇
